{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semester Planner import format v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "active_semester_id", "semesters", "calendar_events"],
  "properties": {
    "schema_version": {"const": 1},
    "active_semester_id": {"$ref": "#/$defs/id"},
    "calendar_events": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/event"}},
    "semesters": {"type": "array", "minItems": 1, "maxItems": 40, "items": {"$ref": "#/$defs/semester"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"},
    "date": {"type": "string", "format": "date"},
    "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "type", "start_date", "end_date"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 100},
        "type": {"enum": ["important", "holiday", "break", "exam", "partial", "final"]},
        "start_date": {"$ref": "#/$defs/date"}, "end_date": {"$ref": "#/$defs/date"},
        "details": {"type": "string", "maxLength": 1000},
        "weekdays_only": {"type": "boolean"},
        "excluded_dates": {"type": "array", "maxItems": 400, "uniqueItems": true, "items": {"$ref": "#/$defs/date"}}
      }
    },
    "semester": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "start_date", "end_date", "default_group_id", "groups", "courses", "sessions", "events"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1, "maxLength": 60},
        "start_date": {"$ref": "#/$defs/date"}, "end_date": {"$ref": "#/$defs/date"},
        "default_group_id": {"$ref": "#/$defs/id"},
        "groups": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "label"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 60}}
        }},
        "courses": {"type": "array", "maxItems": 200, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "title", "kind"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1, "maxLength": 100}, "kind": {"enum": ["lecture", "lab", "tutorial"]}}
        }},
        "sessions": {"type": "array", "maxItems": 1000, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "course_id", "weekday", "start_time", "end_time", "group_ids"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "course_id": {"$ref": "#/$defs/id"},
            "weekday": {"type": "integer", "minimum": 1, "maximum": 7},
            "start_time": {"$ref": "#/$defs/time"}, "end_time": {"$ref": "#/$defs/time"},
            "group_ids": {"type": "array", "uniqueItems": true, "maxItems": 100, "items": {"$ref": "#/$defs/id"}},
            "start_date": {"$ref": "#/$defs/date"}, "end_date": {"$ref": "#/$defs/date"},
            "week_interval": {"type": "integer", "minimum": 1, "maximum": 12},
            "anchor_date": {"$ref": "#/$defs/date"},
            "excluded_dates": {"type": "array", "maxItems": 400, "uniqueItems": true, "items": {"$ref": "#/$defs/date"}},
            "location": {"type": "string", "maxLength": 120}
          }
        }},
        "events": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/event"}}
      }
    }
  }
}
